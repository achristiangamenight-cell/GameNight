rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Comments: anyone can read; anyone can create; auth users can update ratings only
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings']);
      allow delete: if false;
    }
    // Nicknames: doc id = normalized nickname; one uid per nickname
    match /nicknames/{normalizedNickname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'nickname'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}
